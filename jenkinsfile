 pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage completed'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage completed'
            }
        }

        stage('Validation') {
            steps {
                echo 'Starting validation...'
                sh 'test -f README.md'
                sh 'test -f Jenkinsfile'
                echo 'Validation successful!'
            }
        }
    }
}
